PROJECT_NAME=MakeupArt V8
API_V1_STR=/api/v1
ENVIRONMENT=production
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+psycopg2://makeupart:replace-db-password@db:5432/makeupart
CORS_ORIGINS=https://app.example.com
MEDIA_ROOT=/app/media
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
MEDIA_RETENTION_DAYS=30
REFRESH_SESSION_RETENTION_DAYS=7
POSTGRES_USER=makeupart
POSTGRES_PASSWORD=replace-db-password
POSTGRES_DB=makeupart
DOMAIN=api.example.com
CADDY_EMAIL=ops@example.com
