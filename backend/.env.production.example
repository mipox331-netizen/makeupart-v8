PROJECT_NAME=MakeupArt V8
API_V1_STR=/api/v1
ENVIRONMENT=production
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Supabase Postgres connection string. Use the Transaction Pooler/Session Pooler
# connection string from Supabase Dashboard > Connect. Keep the password secret.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres
CORS_ORIGINS=https://YOUR_APP_DOMAIN
MEDIA_ROOT=/app/media
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
MEDIA_RETENTION_DAYS=30
REFRESH_SESSION_RETENTION_DAYS=7
SUBSCRIPTION_TRIAL_DAYS=30
PLATFORM_ADMIN_EMAILS=
