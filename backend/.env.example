PROJECT_NAME=MakeupArt V8
API_V1_STR=/api/v1
ENVIRONMENT=development
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Local development database. Production uses Supabase Postgres.
DATABASE_URL=postgresql+psycopg2://makeupart:makeupart@db:5432/makeupart
CORS_ORIGINS=*
POSTGRES_USER=makeupart
POSTGRES_PASSWORD=makeupart
POSTGRES_DB=makeupart
MEDIA_ROOT=./media
# Optional Google Drive media mirror (OAuth scope: https://www.googleapis.com/auth/drive.file).
# Configure the OAuth consent and refresh token before setting REQUIRE_DURABLE_MEDIA=true.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
REQUIRE_DURABLE_MEDIA=false\nMAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
MEDIA_RETENTION_DAYS=30
REFRESH_SESSION_RETENTION_DAYS=7
SUBSCRIPTION_TRIAL_DAYS=30
PLATFORM_ADMIN_EMAILS=

# Optional paid generative makeup/hairstyle engine; blank means disabled.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium
